{
  "name": "dethz-crawler",
  "version": "0.2.4",
  "description": "CLI tool to pull SKILL.md and agent rules from GitHub into local projects",
  "bin": {
    "dethz-crawler": "dist/index.js"
  },
  "main": "dist/index.js",
  "module": "src/index.ts",
  "type": "module",
  "files": [
    "dist/index.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "build": "bun build src/index.ts --target bun --outdir dist && chmod +x dist/index.js",
    "build:bin": "bun run scripts/build.ts",
    "build:all": "bun run scripts/build.ts --all",
    "lint": "bun run tsc --noEmit",
    "prepublishOnly": "bun run lint && bun test && bun run build",
    "publish:npm": "npm publish",
    "pub": "npm publish"
  },
  "keywords": [
    "agent",
    "skills",
    "rules",
    "ai",
    "bun",
    "cli",
    "cursor",
    "claude",
    "antigravity"
  ],
  "author": "Suphakit P. <me@suphakit.net>",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "chalk": "^6.0.0"
  }
}
